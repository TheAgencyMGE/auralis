{
  "name": "auralis",
  "productName": "Auralis",
  "version": "1.0.0",
  "description": "A web browser for Windows with the look of the Frutiger Aero years: glossy Aqua or Vista glass, live wallpapers, gadgets, Flip 3D, ad blocking and Chrome extensions.",
  "main": "out/main/index.js",
  "author": "Ryan Panda",
  "license": "GPL-3.0-or-later",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/test-unit.mjs",
    "test:e2e": "npm run build && playwright test",
    "dist": "npm run typecheck && npm test && npm run build && node scripts/notices.mjs && electron-builder --win --x64",
    "dist:dir": "npm run build && node scripts/notices.mjs && electron-builder --win --x64 --dir",
    "notices": "node scripts/notices.mjs",
    "fetch-assets": "node scripts/fetch-icons.mjs && node scripts/fetch-art.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.18.2",
    "electron-chrome-extensions": "4.9.0",
    "electron-chrome-web-store": "0.13.0"
  },
  "devDependencies": {
    "@fontsource/m-plus-rounded-1c": "5.3.0",
    "@fontsource/vt323": "5.3.0",
    "@mozilla/readability": "0.6.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "png-to-ico": "3.0.2",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "homepage": "https://theagencymge.github.io/auralis/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheAgencyMGE/auralis.git"
  },
  "bugs": {
    "url": "https://github.com/TheAgencyMGE/auralis/issues"
  },
  "keywords": [
    "browser",
    "web-browser",
    "electron",
    "windows",
    "frutiger-aero",
    "aero",
    "vista",
    "nostalgia"
  ]
}
